<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2E3440">

    <!-- Expression Display -->
    <TextView
        android:id="@+id/solution_tv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/result_tv"
        android:layout_margin="16dp"
        android:gravity="bottom|end"
        android:textColor="#D8DEE9"
        android:textSize="32sp" />

    <!-- Result Display -->
    <TextView
        android:id="@+id/result_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/buttons_layout"
        android:layout_margin="16dp"
        android:gravity="end"
        android:text="0"
        android:textColor="#ECEFF4"
        android:textSize="64sp" />

    <!-- Keypad Layout -->
    <LinearLayout
        android:id="@+id/buttons_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#3B4252"
        android:orientation="vertical"
        android:paddingVertical="16dp">

        <!-- Row 1: C, (, ), / -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_c"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:text="C"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                app:backgroundTint="#BF616A"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_open_bracket"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:text="("
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                app:backgroundTint="#4C566A"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_close_bracket"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:text=")"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                app:backgroundTint="#4C566A"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_divide"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:text="/"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                app:backgroundTint="#D08770"
                app:cornerRadius="36dp" />
        </LinearLayout>

        <!-- Row 2: 7, 8, 9, * -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_7"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:text="7"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                app:backgroundTint="#434C5E"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_8"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:text="8"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                app:backgroundTint="#434C5E"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_9"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:text="9"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                app:backgroundTint="#434C5E"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_multiply"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:text="*"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                app:backgroundTint="#D08770"
                app:cornerRadius="36dp" />
        </LinearLayout>

        <!-- Row 3: 4, 5, 6, + -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_4"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:text="4"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                app:backgroundTint="#434C5E"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_5"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:text="5"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                app:backgroundTint="#434C5E"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_6"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:text="6"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                app:backgroundTint="#434C5E"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_plus"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                app:backgroundTint="#D08770"
                app:cornerRadius="36dp" />
        </LinearLayout>

        <!-- Row 4: 1, 2, 3, - -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_1"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                app:backgroundTint="#434C5E"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_2"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:text="2"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                app:backgroundTint="#434C5E"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_3"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:text="3"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                app:backgroundTint="#434C5E"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_minus"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:text="-"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                app:backgroundTint="#D08770"
                app:cornerRadius="36dp" />
        </LinearLayout>

        <!-- Row 5: AC, 0, ., = -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_ac"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:text="AC"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                app:backgroundTint="#BF616A"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_0"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                app:backgroundTint="#434C5E"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_dot"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:text="."
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                app:backgroundTint="#434C5E"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_equals"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:text="="
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                app:backgroundTint="#EBCB8B"
                app:cornerRadius="36dp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>